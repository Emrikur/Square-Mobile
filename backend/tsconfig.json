{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types":["node", "express"],
    "typeRoots":["./types", "./node_modules/@types"]
  },
  "include": ["src/**/*", "server.ts","types/**/*"],
  "exclude": ["node_modules", "dist"]
}
